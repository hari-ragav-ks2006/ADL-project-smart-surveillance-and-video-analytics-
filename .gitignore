# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# IDEs and local config
.vscode/
.idea/
.agent/

# Testing caches
.pytest_cache/

# Excel lock files
~$*

# OS specific
Thumbs.db
.DS_Store

